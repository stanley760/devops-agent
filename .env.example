# Volcengine DeepSeek 配置
VOLCENGINE_API_KEY=your-volcengine-api-key
# VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DEEPSEEK_THINK_MODEL=deepseek-v3-241226
# DEEPSEEK_QUICK_MODEL=deepseek-v3-241226

# DashScope Embedding 配置
DASHSCOPE_API_KEY=your-dashscope-api-key
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# Milvus 配置
# MILVUS_URL=http://localhost:19530
# MILVUS_DATABASE=agent
# MILVUS_COLLECTION=biz
# MILVUS_USERNAME=
# MILVUS_PASSWORD=

# Prometheus 配置
# PROMETHEUS_URL=http://127.0.0.1:9090

# MySQL 配置（可选）
# MYSQL_DSN=mysql://user:pass@localhost:3306/db

# MCP 配置（可选，腾讯云 CLS）
# MCP_URL=http://localhost:3000/sse

# 文件上传目录
# FILE_DIR=./uploads

# 服务器端口
# SERVER_PORT=6872
